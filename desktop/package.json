{
  "name": "opennote-desktop",
  "productName": "OpenNote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenNote desktop app: local-first notes with the server embedded.",
  "author": { "name": "OpenNote contributors", "email": "opennote@users.noreply.github.com" },
  "homepage": "https://github.com/rldona/OpenNote",
  "license": "MIT",
  "main": "dist/main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "npm run bundle && electron .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "pack": "npm run bundle && electron-builder --dir",
    "dist": "npm run bundle && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
